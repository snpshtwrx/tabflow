{
	"manifest_version": 3,
	"name": "TabFlow",
	"version": "0.2",
	"description": "Easily switch/create tabs using external programs, like Rofi.",

	"permissions": ["tabs", "nativeMessaging", "storage"],
	"optional_permissions": ["webRequest"],

	"options_ui": {
		"page": "options.html"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "@tabflow",
			"strict_min_version": "109.0"
		}
	},
	
	"background": {
		"scripts": ["tabwatcher.js"]
	},

	"icons": {
		"32": "icons/tabflow32.png",
		"64": "icons/tabflow64.png",
		"128": "icons/tabflow128.png"
	}
}
